# Primary MongoDB connection URI (required)
MONGO_DB_DATABASE=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional fallback non-SRV URI (recommended for DNS fallback handling)
MONGO_DB_DATABASE_FALLBACK=mongodb://<username>:<password>@<host1>:27017,<host2>:27017/<database>?replicaSet=<replica-set>&authSource=admin

JWT_SECRET=<your-jwt-secret>
GEMINI_API_KEY=<your-gemini-api-key>
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
SOCKET_CORS_ORIGIN=http://localhost:5173
# Optional Redis URL for multi-instance Socket.IO fan-out
# SOCKET_REDIS_URL=redis://localhost:6379/0

# Firebase Admin (FCM push sending). Provide either service account JSON or 3 fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=<full-service-account-json>
# FIREBASE_PROJECT_ID=<firebase-project-id>
# FIREBASE_CLIENT_EMAIL=<service-account-client-email>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Mongo pool tuning
# MONGO_MAX_POOL_SIZE=40
# MONGO_MIN_POOL_SIZE=5
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Optional API throttling (requests per 15 minutes, per IP)
# RATE_LIMIT_API_MAX=1200
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_SYMPTOM_MAX=80
# RATE_LIMIT_NEARBY_SEARCH_MAX=120
# Suggested starting point for 2 backend instances:
# RATE_LIMIT_API_MAX=4000
# RATE_LIMIT_AUTH_MAX=240
# RATE_LIMIT_SYMPTOM_MAX=320
# RATE_LIMIT_NEARBY_SEARCH_MAX=640

# Optional request logging in production
# ENABLE_HTTP_LOGS=false

PORT=3001

# Primary MongoDB connection URI (required)
MONGO_DB_DATABASE=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional fallback non-SRV URI (recommended for DNS fallback handling)
MONGO_DB_DATABASE_FALLBACK=mongodb://<username>:<password>@<host1>:27017,<host2>:27017/<database>?replicaSet=<replica-set>&authSource=admin

JWT_SECRET=<your-jwt-secret>
GEMINI_API_KEY=<your-gemini-api-key>
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
SOCKET_CORS_ORIGIN=http://localhost:5173

# Firebase Admin (FCM push sending). Provide either service account JSON or 3 fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=<full-service-account-json>
# FIREBASE_PROJECT_ID=<firebase-project-id>
# FIREBASE_CLIENT_EMAIL=<service-account-client-email>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PORT=3001
